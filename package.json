{
  "name": "@v-bible/gallica-scraper",
  "type": "module",
  "version": "1.1.0",
  "description": "Digital Gallica Library Scraper",
  "author": "v-bible",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v-bible/gallica-scraper.git"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/cli.d.mts",
        "require": "./dist/cli.d.cts"
      },
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cli.cjs",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.mts",
  "bin": {
    "gallica-scraper": "dist/cli.js",
    "__gallica-scraper_bash_complete": "dist/bash-complete.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "postinstall": "npx @stricli/auto-complete@latest install gallica-scraper --bash __gallica-scraper_bash_complete"
  },
  "dependencies": {
    "@stricli/auto-complete": "1.3.0",
    "@stricli/core": "1.3.0",
    "dotenv": "17.4.2",
    "es-toolkit": "1.49.0",
    "pdf-lib": "1.17.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-format": "2.0.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
